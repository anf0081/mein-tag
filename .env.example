# --- KI-Anbieter: anthropic (Claude) oder deepseek ---
AI_PROVIDER=anthropic
# Claude: API-Schlüssel (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# DeepSeek: API-Schlüssel (platform.deepseek.com > API keys), nur bei AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DeepSeek-Modelle: deepseek-flash (Standard) oder deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BRIEF_MODEL=
# DEEPSEEK_ONBOARDING_MODEL=
# Modell für Chat und Morgenbrief (claude-sonnet-5-5 = zuverlässig, claude-haiku-5-5 = günstiger)
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: anderes Modell nur für den Brief
# BRIEF_MODEL=
# Onboarding und Onboarding-Überblick laufen immer mit Sonnet (änderbar):
# ONBOARDING_MODEL=claude-sonnet-5-5
# Passwort für die App (mind. 8 Zeichen, gern länger)
APP_PASSWORD=

# --- Server ---
HOST=127.0.0.1
PORT=8080
# Zeitzone, bis in der App ein Ort eingestellt ist (der Ort setzt sie dann automatisch)
TZ=Europe/Berlin
DATA_FILE=./data/state.json
# Hinter Caddy/nginx mit HTTPS: beide auf 1
TRUST_PROXY=1
COOKIE_SECURE=1
# Kontaktadresse für Push-Dienste (beliebige eigene Mailadresse)
VAPID_SUBJECT=mailto:du@example.com
# Optional: öffentliche Adresse der App (sonst aus der Anfrage ermittelt), z. B. für die Google-Weiterleitung
# PUBLIC_URL=https://meintag.deine-domain.de

# --- Datenschutzseite (/datenschutz) – brauchst du z. B. für die Google-Freigabe ---
PRIVACY_OPERATOR=
# Mailadresse oder Website
PRIVACY_CONTACT=
# z. B. Deutschland
PRIVACY_SERVER_LOCATION=

# --- Google Kalender + Aufgaben: am einfachsten in der App unter „Über dich“ verbinden. ---
# Nur falls du es lieber hier einträgst (hat dann Vorrang):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Name der Google-Aufgaben-Liste, die synchronisiert wird (wird angelegt, falls nicht vorhanden)
# GOOGLE_TASKLIST=Alle Aufgaben   (Name der Google-Aufgabenliste; Standard: Alle Aufgaben)
# 0 = Aufgaben-Sync aus
GOOGLE_TASKS=1
# Zweite Liste nur mit den heutigen Aufgaben und fälligen Routinen (0 = aus)
GOOGLE_TODAY_LIST=Heute
GOOGLE_TODAY=1

# 1 = Claude holt im Morgenbrief per Websuche Nachrichten zu deinen Themen
NEWS_ENABLED=1
